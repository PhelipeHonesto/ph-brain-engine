# Supabase Postgres connection string.
# Use the "Session" pooler URL (port 5432) for best compatibility with prepared statements.
# Transaction pooler (port 6543) also works but requires prepare=false at the driver.
DATABASE_URL=postgres://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Voyage AI API key — get one at https://www.voyageai.com/
VOYAGE_API_KEY=

# Optional: override default embedding model (voyage-3-large) and dimensions (2048).
# Changing these invalidates existing embeddings.
# VOYAGE_MODEL=voyage-3-large
# VOYAGE_DIMENSIONS=2048

# Optional: debug logging for the hybrid search pipeline.
# PH_BRAIN_SEARCH_DEBUG=1
